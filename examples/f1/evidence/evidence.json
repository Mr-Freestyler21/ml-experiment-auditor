      "path": "train.py",
      "total_lines": 80,
      "content": "   1  \"\"\"F1 pit-stop prediction: initial model with a random 80/20 split.\n   2  \n   3  Adapted from f1.ipynb (cells 1, 21, 23, 25) in\n   4  github.com/Mr-Freestyler21/f1-pit-stop-prediction. The modelling code is unchanged,\n   5  including the random split, so the auditor has the original evaluation to examine.\n   6  Only the output changed: metrics are written to metrics.json in AUDIT_OUTPUT_DIR.\n   7  \"\"\"\n   8  \n   9  import json\n  10  import os\n  11  from pathlib import Path\n  12  \n  13  import pandas as pd\n  14  from sklearn.ensemble import RandomForestClassifier\n  15  from sklearn.metrics import (\n  16      accuracy_score,\n  17      classification_report,\n  18      f1_score,\n  19      precision_score,\n  20      recall_score,\n  21      roc_auc_score,\n  22  )\n  23  from sklearn.model_selection import train_test_split\n  24  from sklearn.preprocessing import LabelEncoder\n  25  \n  26  HERE = Path(__file__).resolve().parent\n  27  \n  28  # Cell 1\n  29  df = pd.read_csv(HERE / \"data\" / \"laps.csv\")\n  30  \n  31  # Cell 21\n  32  features = ['Compound', 'TyreLife', 'Position', 'LapTime (s)',\n  33              'RaceProgress', 'Stint', 'LapTime_Delta', 'Cumulative_Degradation']\n  34  \n  35  target = 'PitNextLap'\n  36  \n  37  ml_data = df[df['LapTime (s)'] <= 200][features + [target]].dropna()\n  38  \n  39  le = LabelEncoder()\n  40  ml_data = ml_data.copy()\n  41  ml_data['Compound'] = le.fit_transform(ml_data['Compound'])\n  42  \n  43  # Cell 23\n  44  X = ml_data[features]\n  45  y = ml_data[target]\n  46  \n  47  X_train, X_test, y_train, y_test = train_test_split(\n  48      X, y, test_size=0.2, random_state=42\n  49  )\n  50  \n  51  model_v1 = RandomForestClassifier(n_estimators=100, random_state=42)\n  52  model_v1.fit(X_train, y_train)\n  53  \n  54  # Cell 25\n  55  y_pred_v1 = model_v1.predict(X_test)\n  56  \n  57  accuracy_v1 = accuracy_score(y_test, y_pred_v1)\n  58  print(f'Accuracy: {accuracy_v1:.2f}')\n  59  print()\n  60  print(classification_report(y_test, y_pred_v1))\n  61  \n  62  # Added for the auditor: write metrics where the sandbox can collect them.\n  63  y_proba_v1 = model_v1.predict_proba(X_test)[:, 1]\n  64  positive_rate = float(y_test.mean())\n  65  metrics = {\n  66      \"accuracy\": float(accuracy_v1),\n  67      \"precision\": float(precision_score(y_test, y_pred_v1)),\n  68      \"recall\": float(recall_score(y_test, y_pred_v1)),\n  69      \"f1\": float(f1_score(y_test, y_pred_v1)),\n  70      \"roc_auc\": float(roc_auc_score(y_test, y_proba_v1)),\n  71      \"majority_class_accuracy\": max(positive_rate, 1 - positive_rate),\n  72      \"test_positive_rate\": positive_rate,\n  73      \"n_train\": int(len(X_train)),\n  74      \"n_test\": int(len(X_test)),\n  75  }\n  76  \n  77  out_dir = Path(os.environ.get(\"AUDIT_OUTPUT_DIR\", HERE))\n  78  out_dir.mkdir(parents=True, exist_ok=True)\n  79  (out_dir / \"metrics.json\").write_text(json.dumps(metrics, indent=2))\n  80  print(json.dumps(metrics, indent=2))"
    }
  },
